{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "MongoDb": {
    "ConnectionString": "mongodb://mongo:27017",
    "DatabaseName": "enterprise_media_vault",
    "GridFsBucketName": "vault_files"
  },
  "Jwt": {
    "Issuer": "EnterpriseMediaVault",
    "Audience": "EnterpriseMediaVault.Client",
    "Secret": "CHANGE_ME_very_secure_key_minimum_32_characters",
    "ExpirationMinutes": 60
  },
  "Storage": {
    "DefaultStrategy": "gridfs",
    "LocalPath": "storage"
  },
  "AllowedHosts": "*"
}
